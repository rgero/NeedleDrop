{
    "views": [
        {
            "name": "ordered_playlogs",
            "schema": "public",
            "definition": " SELECT id,\n    created_at,\n    date,\n    listeners,\n    album_id,\n    notes,\n    row_number() OVER (ORDER BY date) AS play_number\n   FROM playlogs;"
        },
        {
            "name": "ordered_vinyls",
            "schema": "public",
            "definition": " SELECT row_number() OVER (ORDER BY created_at) AS purchase_number,\n    id,\n    created_at,\n    artist,\n    album,\n    purchase_date,\n    purchase_location,\n    price,\n    owners,\n    length,\n    notes,\n    liked_by,\n    color,\n    image_url,\n    double_lp,\n    purchased_by,\n    tags,\n    archived,\n    release_date\n   FROM vinyls\n  WHERE (archived IS NOT TRUE);"
        }
    ],
