    "functions": [
        {
            "name": "fn_sync_location_purchase_count",
            "schema": "public",
            "security": "security_invoker",
            "arguments": "",
            "languages": "plpgsql",
            "definition": "CREATE OR REPLACE FUNCTION public.fn_sync_location_purchase_count()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$BEGIN\r\n    -- HANDLE DELETE: Decrement the old location\r\n    IF (TG_OP = 'DELETE') THEN\r\n        UPDATE locations \r\n        SET purchase_count = purchase_count - 1 \r\n        WHERE id = OLD.purchase_location;\r\n        RETURN OLD;\r\n\r\n    -- HANDLE INSERT: Increment the new location\r\n    ELSIF (TG_OP = 'INSERT') THEN\r\n        UPDATE locations \r\n        SET purchase_count = purchase_count + 1 \r\n        WHERE id = NEW.purchase_location;\r\n        RETURN NEW;\r\n\r\n    -- HANDLE UPDATE: Adjust if the location changed\r\n    ELSIF (TG_OP = 'UPDATE') THEN\r\n        IF (OLD.purchase_location IS DISTINCT FROM NEW.purchase_location) THEN\r\n            -- Subtract from the location it left\r\n            UPDATE locations \r\n            SET purchase_count = purchase_count - 1 \r\n            WHERE id = OLD.purchase_location;\r\n            \r\n            -- Add to the location it moved to\r\n            UPDATE locations \r\n            SET purchase_count = purchase_count + 1 \r\n            WHERE id = NEW.purchase_location;\r\n        END IF;\r\n        RETURN NEW;\r\n    END IF;\r\nEND;$function$\n",
            "return_type": "trigger",
            "arguments_with_defaults": ""
        },
        {
            "name": "get_unplayed_counts",
            "schema": "public",
            "security": "security_invoker",
            "arguments": "target_user_ids uuid[]",
            "languages": "plpgsql",
            "definition": "CREATE OR REPLACE FUNCTION public.get_unplayed_counts(target_user_ids uuid[])\n RETURNS TABLE(title uuid, count bigint)\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n    RETURN QUERY\r\n    SELECT \r\n        u.id AS user_id, \r\n        COUNT(v.id) AS unplayed_count\r\n    FROM unnest(target_user_ids) AS u(id)\r\n    CROSS JOIN vinyls AS v\r\n    WHERE NOT EXISTS (\r\n        SELECT 1\r\n        FROM playlogs AS p\r\n        WHERE p.album_id = v.id\r\n          AND u.id = ANY(p.listeners)\r\n    )\r\n    GROUP BY u.id;\r\nEND;\r\n$function$\n",
            "return_type": "TABLE(title uuid, count bigint)",
            "arguments_with_defaults": "target_user_ids uuid[]"
        },
        {
            "name": "get_unplayed_vinyls",
            "schema": "public",
            "security": "security_invoker",
            "arguments": "target_user_id uuid",
            "languages": "plpgsql",
            "definition": "CREATE OR REPLACE FUNCTION public.get_unplayed_vinyls(target_user_id uuid)\n RETURNS SETOF vinyls\n LANGUAGE plpgsql\nAS $function$BEGIN\r\n    RETURN QUERY\r\n    SELECT v.*\r\n    FROM vinyls AS v\r\n    WHERE NOT EXISTS (\r\n        SELECT 1\r\n        FROM playlogs AS p\r\n        WHERE p.album_id = v.id\r\n          AND target_user_id = ANY(p.listeners)\r\n    );\r\nEND;$function$\n",
            "return_type": "SETOF vinyls",
            "arguments_with_defaults": "target_user_id uuid"
        },
        {
            "name": "handle_new_user",
            "schema": "public",
            "security": "security_definer",
            "arguments": "",
            "languages": "plpgsql",
            "definition": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\ndeclare\r\n  full_name text;\r\n  parsed_name text;\r\nbegin\r\n  -- Try full_name first, then name from metadata\r\n  full_name :=\r\n    coalesce(\r\n      new.raw_user_meta_data->>'full_name',\r\n      new.raw_user_meta_data->>'name'\r\n    );\r\n\r\n  parsed_name :=\r\n    split_part(full_name, ' ', 1);\r\n\r\n  insert into public.users (id, email, name)\r\n  values (\r\n    new.id,\r\n    new.email,\r\n    nullif(parsed_name, '')\r\n  );\r\n\r\n  return new;\r\nend;\r\n$function$\n",
            "return_type": "trigger",
            "arguments_with_defaults": ""
        },
        {
            "name": "update_vinyl_play_count",
            "schema": "public",
            "security": "security_invoker",
            "arguments": "",
            "languages": "plpgsql",
            "definition": "CREATE OR REPLACE FUNCTION public.update_vinyl_play_count()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$begin\r\n    -- Handle NEW insertions\r\n    if (TG_OP = 'INSERT') then\r\n        update vinyls\r\n        set \"play_count\" = \"play_count\" + 1\r\n        where id = new.album_id;\r\n\r\n    -- Handle DELETIONS\r\n    elsif (TG_OP = 'DELETE') then\r\n        update vinyls\r\n        set \"play_count\" = \"play_count\" - 1\r\n        where id = old.album_id;\r\n\r\n    -- Handle UPDATES (if the album_id is changed on a log)\r\n    elsif (TG_OP = 'UPDATE') then\r\n        if (old.album_id is distinct from new.album_id) then\r\n            -- Decrease the old vinyl count\r\n            update vinyls\r\n            set \"play_count\" = \"play_count\" - 1\r\n            where id = old.album_id;\r\n            \r\n            -- Increase the new vinyl count\r\n            update vinyls\r\n            set \"play_count\" = \"play_count\" + 1\r\n            where id = new.album_id;\r\n        end if;\r\n    end if;\r\n    return null;\r\nend;$function$\n",
            "return_type": "trigger",
            "arguments_with_defaults": ""
        }
    ],
